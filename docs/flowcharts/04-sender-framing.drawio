<mxfile host="app.diagrams.net">
  <diagram id="sender-framing" name="04 Sender Framing">
    <mxGraphModel dx="1000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="send(nals)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="empty" value="nalData.empty() ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="300" y="110" width="120" height="70" as="geometry" />
        </mxCell>

        <mxCell id="rettrue0" value="return true" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="480" y="125" width="100" height="40" as="geometry" />
        </mxCell>

        <mxCell id="assemble" value="zloz ramke:&#10;frame = nals + AUD(6B)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="285" y="230" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="offset" value="offset = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="285" y="330" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="loopq" value="offset &lt; frame.size() ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="290" y="410" width="150" height="70" as="geometry" />
        </mxCell>

        <mxCell id="rettrue1" value="return true" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="520" y="425" width="100" height="40" as="geometry" />
        </mxCell>

        <mxCell id="chunk" value="chunk = min(60000,&#10;size - offset)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="285" y="530" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="mode" value="DJI_STREAM_SIMULATE ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="290" y="620" width="150" height="70" as="geometry" />
        </mxCell>

        <mxCell id="fwrite" value="fwrite(..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="80" y="640" width="130" height="40" as="geometry" />
        </mxCell>

        <mxCell id="sdk" value="SendVideoStream(..." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="560" y="640" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="wq" value="zapisano == chunk ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="80" y="720" width="130" height="60" as="geometry" />
        </mxCell>

        <mxCell id="rcq" value="rc == SUCCESS ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="570" y="720" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="retfalse0" value="return false" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="820" width="110" height="40" as="geometry" />
        </mxCell>

        <mxCell id="logrc" value="log rc&#10;return false" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="580" y="820" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="offsetadd" value="offset += chunk" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="285" y="730" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="audnote" value="AUD = 00 00 00 01 09 10&#10;doklejany NA KONCU ramki" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="230" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- krawedzie -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="start" target="empty"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="TAK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="empty" target="rettrue0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="NIE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="empty" target="assemble"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="assemble" target="offset"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="offset" target="loopq"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="NIE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="loopq" target="rettrue1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="TAK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="loopq" target="chunk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="chunk" target="mode"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="stub" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="mode" target="fwrite"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="real" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="mode" target="sdk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="fwrite" target="wq"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="sdk" target="rcq"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="NIE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="wq" target="retfalse0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="NIE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="rcq" target="logrc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="TAK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="wq" target="offsetadd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="TAK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="rcq" target="offsetadd"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;dashed=1;" edge="1" parent="1" source="offsetadd" target="loopq"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
