<mxfile host="app.diagrams.net">
  <diagram id="init-sequence" name="06 Init Sequence">
    <mxGraphModel dx="1000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="DjiUser_ApplicationStart()" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="init" value="DjiCore_Init(userInfo)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="270" y="110" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="base" value="DjiAircraftInfo_GetBaseInfo&#10;+ sprawdzenie mount position" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="270" y="190" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="meta" value="DjiCore_SetAlias /&#10;SetFirmwareVersion / SetSerialNumber" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="270" y="280" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="caminit" value="DjiPayloadCamera_Init()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="270" y="370" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="reghandler" value="DjiPayloadCamera_RegCommonHandler&#10;(GetSystemState / SetMode / GetMode)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="250" y="450" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="settype" value="DjiPayloadCamera_SetVideoStreamType&#10;(DJI_CAMERA_VIDEO_STREAM_TYPE_H264_DJI_FORMAT)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="540" width="220" height="50" as="geometry" />
        </mxCell>

        <mxCell id="others" value="inne rejestracje&#10;(gimbal, widget, power...)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="270" y="630" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="appstart" value="DjiCore_ApplicationStart()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="270" y="710" width="160" height="40" as="geometry" />
        </mxCell>

        <mxCell id="menu" value="menu: 'v'&#10;pipeline.start() -&gt; SendVideoStream" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="250" y="790" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="critical" value="!!! KRYTYCZNE !!!&#10;MUSI byc PRZED DjiCore_ApplicationStart&#10;(dji_payload_camera.h:803).&#10;Inaczej SDK uzyje domyslnego typu&#10;i zablokuje API na 10s." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#CC0000;dashed=1;fontColor=#CC0000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="540" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="SendVideoStream dziala&#10;DOPIERO po ApplicationStart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="780" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- krawedzie -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="start" target="init"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="init" target="base"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="base" target="meta"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="meta" target="caminit"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="caminit" target="reghandler"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeWidth=3;strokeColor=#CC0000;" edge="1" parent="1" source="reghandler" target="settype"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="settype" target="others"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="others" target="appstart"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;" edge="1" parent="1" source="appstart" target="menu"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
