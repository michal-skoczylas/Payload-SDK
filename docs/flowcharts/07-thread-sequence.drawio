<mxfile host="app.diagrams.net">
  <diagram id="thread-sequence" name="07 Thread Sequence">
    <mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- linie zycia -->
        <mxCell id="mainBox" value="main()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="workerBox" value="worker thread&#10;VideoStreamPipeline::run()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="530" y="20" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- linie pionowe -->
        <mxCell id="mainLife" value="" style="endArrow=none;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="210" y="70" width="1" height="580" as="geometry" />
        </mxCell>
        <mxCell id="workerLife" value="" style="endArrow=none;strokeColor=#999999;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="70" width="1" height="580" as="geometry" />
        </mxCell>

        <!-- start() -->
        <mxCell id="msg1" value="start()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;fontSize=12;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="210" y="120" as="sourcePoint" />
            <mxPoint x="600" y="120" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="setrunning" value="running_ = true&#10;std::thread(run)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="420" y="150" width="150" height="40" as="geometry" />
        </mxCell>

        <mxCell id="loop" value="while (running_) {&#10;  readFrame -&gt; encode -&gt; send&#10;  odczyt running_ (atomic)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="420" y="250" width="150" height="80" as="geometry" />
        </mxCell>

        <mxCell id="busy" value="(main dziala dalej:&#10;menu, sleep, logi)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="140" y="220" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- stop() -->
        <mxCell id="msg2" value="stop()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;fontSize=12;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="210" y="400" as="sourcePoint" />
            <mxPoint x="600" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="setfalse" value="running_ = false&#10;(main pisze: atomic)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1">
          <mxGeometry x="420" y="430" width="150" height="40" as="geometry" />
        </mxCell>

        <mxCell id="exitloop" value="petla konczy sie,&#10;run() wraca" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1">
          <mxGeometry x="420" y="520" width="150" height="40" as="geometry" />
        </mxCell>

        <mxCell id="join" value="join()&#10;(main czeka na watku)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1">
          <mxGeometry x="140" y="500" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- powrot z watku -->
        <mxCell id="msg3" value="join() zwraca" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="600" y="560" as="sourcePoint" />
            <mxPoint x="210" y="530" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="note" value="atomic&lt;bool&gt; running_:&#10;main pisze (stop), worker czyta (petla)&#10;-&gt; bez atomika data race / UB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#CC0000;dashed=1;fontColor=#CC0000;" vertex="1" parent="1">
          <mxGeometry x="620" y="580" width="210" height="70" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="send() wolany z wątku roboczego,&#10;nie z main - dlatego osobny watek&#10;(nie blokuje menu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="190" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
